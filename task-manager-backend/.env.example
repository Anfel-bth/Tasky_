PORT=5000

# Use DATABASE_URL for hosted PostgreSQL, or provide the individual DB_* values.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tasky
DB_USER=postgres
DB_PASSWORD=replace-me
# Set true only when your database provider requires TLS and its certificate is trusted.
DB_SSL=false

JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173

# Recommended for hosts that restrict outbound SMTP: Resend sends over HTTPS.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Tasky <no-reply@your-verified-domain.example>

# To use SMTP instead, set EMAIL_PROVIDER=smtp and configure these values.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
